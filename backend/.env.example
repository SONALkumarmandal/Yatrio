APP_NAME="Yatrio"
ENVIRONMENT=development

# Neon: copy the connection string from the Neon dashboard (keep ?sslmode=require)
DATABASE_URL=postgresql://USER:PASSWORD@ep-xxxx.region.aws.neon.tech/neondb?sslmode=require

# Required; generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET_KEY=
ACCESS_TOKEN_EXPIRE_MINUTES=60

CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_FOLDER=

CORS_ORIGINS=http://localhost:3000,http://localhost:5173,http://127.0.0.1:5173,http://localhost:4173,https://yatrio.vercel.app

# Optional: set both values to auto-create the first admin on startup.
# Use a unique password of at least 16 characters; there is no default admin account.
FIRST_ADMIN_EMAIL=
FIRST_ADMIN_USERNAME=
FIRST_ADMIN_PASSWORD=
